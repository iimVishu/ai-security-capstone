        <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;font color='#B42318'&gt;RED&lt;/font&gt; = High risk assessment&lt;br&gt;&lt;font color='#B54708'&gt;AMBER&lt;/font&gt; = Medium risk assessment&lt;br&gt;&lt;font color='#087443'&gt;GREEN&lt;/font&gt; = Low risk assessment&lt;br&gt;&lt;br&gt;&lt;font color='#475467'&gt;Risk ratings are assessment classifications based on confirmed tool identifiers and are not confirmed vulnerabilities. No successful attacks are claimed. Schemas, parameters, resources, and prompts remain pending verification.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#98A2B3;fontColor=#101828;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1220" y="610" width="540" height="150" as="geometry" /></mxCell>

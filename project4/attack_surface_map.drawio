        <mxCell id="t-get-env" value="&lt;b&gt;Print Environment Tool&lt;/b&gt;&lt;br&gt;&lt;font color='#667085'&gt;get-env&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;HIGH&lt;/font&gt;&lt;br&gt;&lt;font color='#344054'&gt;Potential abuse: seek sensitive configuration if environment data is returned.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;fontColor=#101828;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="540" height="86" as="geometry" /></mxCell>
